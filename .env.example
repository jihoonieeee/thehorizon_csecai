# ── The Horizon — Environment Variables ──────────────────────────────────────
# Copy to .env and fill in values. Never commit .env to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Vercel Blob ───────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── API Auth ──────────────────────────────────────────────────────────────────
CRON_SECRET=your-secret-token

# ── Platform LLM seam (the swappable key) ─────────────────────────────────────
# Single indirection point for ALL chatbot LLM calls (and the pipeline's Gemini
# path). Swap providers by changing these three vars — no code changes.
# See lib/llm/platformProvider.js; verify with: node scripts/checkLlmProvider.js
PLATFORM_AI_PROVIDER=gemini              # gemini | openai-compatible | anthropic
PLATFORM_AI_API_KEY=                     # the one key; falls back to the provider-specific key below if blank
PLATFORM_AI_BASE_URL=                    # only for openai-compatible gateways (e.g. https://gateway.example/v1)
# Optional tier → model overrides (defaults are per-provider):
#   gemini: cheap/standard=gemini-2.5-flash, synthesis=gemini-2.5-pro
PLATFORM_MODEL_CHEAP=
PLATFORM_MODEL_STANDARD=
PLATFORM_MODEL_SYNTHESIS=

# ── LLM Provider Keys ─────────────────────────────────────────────────────────
# At least one Gemini key is strongly recommended — it's the default provider.
# For a fully gemini-only dev run also set LLM_PROVIDER_ORDER=gemini below.

# Gemini (Google AI Studio — free tier available)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=   # optional second key for rotation / quota headroom

# Groq (free hosted Llama — fast, JSON mode only, no structured output schema)
# https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic Claude (frontier-model provider — used for evidence_search + strategic_insight only)
# Only called once per category per pipeline run (never per source).
# Model: claude-sonnet-4-6 (override with ANTHROPIC_MODEL)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=    # optional override, default: claude-sonnet-4-6

# OpenAI (optional — gpt-4o-mini; legacy provider, not in default routing table)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_API_KEY_2=   # optional second key

# Cloudflare Workers AI (free tier inference — good for bulk classification)
# https://dash.cloudflare.com → Workers & Pages → Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenRouter (hosted model marketplace — fallback before local Ollama)
# https://openrouter.ai/keys — free-tier models available with no spend required
# Two keys supported for quota rotation; KEY_2 is tried when KEY_1 is exhausted.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=            # optional second key for rotation
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter model selection — all model IDs centralized here.
# "openrouter/auto" routes to the best available free model automatically.
# Override individual vars to pin specific models.
OPENROUTER_DEFAULT_MODEL=openrouter/auto
OPENROUTER_CHEAP_MODEL=openrouter/auto          # cheap/bulk tasks
OPENROUTER_REASONING_MODEL=openai/gpt-oss-20b:free  # extraction/analysis fallback

# ── LLM Router Configuration ──────────────────────────────────────────────────

# Routing mode — controls which models are used at each pipeline layer
#   dev     — Gemini 2.5 Flash for extraction; Gemini 2.5 Pro for synthesis
#   cheap   — Flash Lite for bulk; 2.5 Flash for extraction and synthesis
#   quality — 2.5 Flash for extraction; 2.5 Pro for analysis, slides, QA
#   local   — Ollama → Groq fallback; deterministic fallbacks for synthesis
LLM_MODE=dev

# Gemini-only hard lock. When set (1/true/yes), NO provider other than Gemini may
# be used — on the router, the legacy callLLM() path, AND the chatbot platform seam
# — regardless of LLM_PROVIDER_ORDER / PLATFORM_AI_PROVIDER / task preferences.
# Use during Gemini-only development; unset to restore multi-provider routing.
LLM_ONLY_GEMINI=1

# Provider priority order (comma-separated, left = highest priority)
# Each provider is tried in order unless quota-exhausted or unavailable.
# Task profiles may further filter which providers are suitable per task.
# (Ignored while LLM_ONLY_GEMINI is set.)
LLM_PROVIDER_ORDER=gemini,groq,cloudflare,openrouter,ollama

# Call timeout per provider attempt (milliseconds)
LLM_TIMEOUT_MS=45000

# Max retries per provider on rate-limit (not quota exhaustion)
LLM_MAX_RETRIES=3

# Prompt cache TTL (hours) — in-memory + optional disk cache
# Set LLM_CACHE_DIR to enable disk persistence across process restarts
LLM_CACHE_TTL_HOURS=48
LLM_CACHE_DIR=.llm_cache   # comment out to disable disk cache

# Daily token budget guard (estimated tokens across all calls, 0 = unlimited)
# Warning at 80%, error at 100%. Rough estimate: 1M tokens ≈ $0.10–$1.00
LLM_DAILY_TOKEN_BUDGET=0

# ── Local Ollama (last-resort fallback only) ──────────────────────────────────
# Ollama must be installed and running locally. Only used when all hosted
# providers fail AND the task allows local models (allow_local: true).
# https://ollama.com — run: ollama pull qwen2.5:0.5b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
